# Copy this file to .env.local and fill in every value before running the app.
# Nothing here has a working default in production code — features fail loudly
# (not silently, not with mock data) when their env vars are missing.

# ---- Supabase (client-safe) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase (server only — NEVER prefix these with NEXT_PUBLIC_) ---------
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (server only, used by the ai-agent-turn Edge Function) -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# ---- OpenAI (server only, optional — powers RAG embeddings; agent chat
#      still works without it, just without retrieval-grounded knowledge) --
OPENAI_API_KEY=

# ---- Resend / email (server only) ------------------------------------------
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Claimora <no-reply@claimora.app>"

# ---- Twilio / SMS (server only) --------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Stripe (server + one client-safe publishable key) ---------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- OTP / claim-token signing (server only) -------------------------------
OTP_HASH_PEPPER=
CLAIM_TOKEN_SECRET=

# ---- Rate limiting (server only, optional but strongly recommended) -------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Monitoring --------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ---- App config --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
CRON_SECRET=

# ---- Demo mode (do not enable in a real production deployment) ------------
# When true, the Pro upgrade button bypasses Stripe entirely via
# app/api/billing/demo-upgrade/route.ts and instantly marks the profile
# 'pro' — for live demos without Stripe credentials configured. The real
# Stripe path (app/api/billing/checkout, supabase/functions/stripe-webhook)
# is untouched and becomes active again the moment this is set to false.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
